{
  "openapi": "3.0.0",
  "info": { "version": "1.0.0", "title": "Commoncrypt Heart" },
  "paths": {
    "/email/request-code": {
      "post": {
        "summary": "Requests an email code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An email verification code has been sent"
          }
        }
      }
    },
    "/email/confirm-code": {
      "post": {
        "summary": "Confirms an email code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "email_code": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The email code has been validated as correct",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session_token": { "type": "string" },
                    "session_token_expiry": { "type": "integer" }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The email code is incorrect"
          }
        }
      }
    },
    "/account/register": {
      "summary": "Registers an account",
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "session_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account was successfully registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "bearer_token": { "type": "string" },
                    "bearer_token_expiry": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/account/authenticate": {
      "summary":
    },
    "/account/complete-authentication": {},
    "/app/register": {},
    "/app/authenticate": {}
  },
  "components": {
    "schemas": {}
  }
}
