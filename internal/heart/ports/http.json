{
  "openapi": "3.0.0",
  "info": { "version": "1.0.0", "title": "Commoncrypt Auth Service" },
  "paths": {
    "/push/challenge": {
      "post": {
        "summary": "Generates a challenge for push-based authentication",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A challenge has been generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challenge_expiry": { "type": "integer" },
                    "challenge_token": { "type": "string" },
                    "challenge_seed": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/push/authenticate": {
      "post": {
        "summary": "Polls for the successful completion of a challenge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "challenge_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The challenge has been completed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "const": "completed" },
                    "access_expiry": { "type": "integer" },
                    "access_token": { "type": "string" },
                    "refresh_expiry": { "type": "integer" },
                    "refresh_token": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "The challenge is still pending but has neither expired nor been rejected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "const": "pending" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "The challenge could not be located, perhaps due to expiry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "const": "notfound" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
