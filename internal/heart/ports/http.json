{
  "openapi": "3.0.0",
  "info": { "version": "1.0.0", "title": "Commoncrypt Heart" },
  "paths": {
    "/email/request-code": {
      "summary": "",
      "description": "Requests an email verification code, which is required by registration endpoints.",
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An email verification code has been sent."
          }
        }
      }
    },
    "/account/register": {
      "summary": "Registers an account",
      "description": "Accepts an email verification code and completes account registration.",
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "code": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account registration has been completed."
          }
        }
      }
    },
    "/account/authenticate": {},
    "/account/complete-authentication": {},
    "/app/register": {},
    "/app/authenticate": {}
  },
  "components": {
    "schemas": {}
  }
}
